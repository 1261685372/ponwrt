#include "an7581-nokia_xg-040g-md-common.dtsi"
#include "an758x-nokia_xg-040g-ubi-parts.dtsi"

/ {
	model = "Nokia XG-040G-MD (UBI, 10G SFP)";
	compatible = "nokia,xg-040g-md-ubi", "airoha,an7581",
		     "airoha,en7581";
	variant = "10g-sfp";

	sfp0: sfp {
		compatible = "sff,sfp";

		i2c-bus = <&sfp_i2c>;

		maximum-power-milliwatt = <3000>;
	};

	/*
	 * The external MDIO pins (GPIO1 = MDC, GPIO2 = MDIO) are only used
	 * by the EN8811H PHY, which this variant does not have. Reuse them
	 * as a bit-banged I2C bus for the SFP EEPROM.
	 */
	sfp_i2c: i2c-sfp {
		compatible = "i2c-gpio";

		sda-gpios = <&en7581_pinctrl 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&en7581_pinctrl 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;	/* ~100 kHz */

		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&mdio {
	/delete-node/ ethernet-phy@f;
};

/*
 * Drop the external MDIO pinmux so GPIO1/GPIO2 are usable by i2c-gpio.
 * The switch PHYs are accessed through the internal MDIO bus and do not
 * need the external pins.
 */
&switch {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&eth_pcs {
	status = "okay";
};

&gdm4 {
	/delete-property/ pcs-handle;
	/delete-property/ phy-handle;
	/delete-property/ phy-mode;

	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	lan_10g: ethernet-port@0 {
		compatible = "airoha,eth-port";
		reg = <0>;
		managed = "in-band-status";
		pcs-handle = <&eth_pcs>;
		phy-mode = "10gbase-r";
		sfp = <&sfp0>;
		nvmem-cell-names = "mac-address";
		nvmem-cells = <&macaddr_factory_3e 0>;
		openwrt,netdev-name = "lan1";
		status = "okay";
	};
};
